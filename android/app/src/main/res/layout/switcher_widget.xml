<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen task switcher (D49): 2 x 4 tiles at the bottom. The tile
     images have the shape of one slot of this widget, at most as tall as
     the app's tiles (D62); the rows take their height (adjustViewBounds),
     so any space left is above the tiles (and the timer), toward the
     thumb-far end, as in the app. The optional timer row (D62)
     sits above them, left-aligned, 20 dp high
     (SwitcherWidget.timerRowHeight), and is gone unless turned on in
     Settings. Tapping an empty slot opens "Set up activity" for it; the
     background does nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:clipChildren="false"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical">
    <!-- Styled like the app's header (D62): the session in the primary
         colour, today's total in onSurfaceVariant, both medium weight.
         With Neon the session glows in the primary colour; text shadows
         cannot be set at run time, so there is one session view per glow
         colour (generated) and the provider shows the right one. clipChildren
         is off so the glow may spread past the text's box. -->
    <LinearLayout
        android:id="@+id/timer_row"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:clipChildren="false">
            <Chronometer
                android:id="@+id/timer_session"
                style="@style/WidgetTimerSession" />
            <!-- glow variants: generated by tool/generate_widget_glow.py -->
            <Chronometer
                android:id="@+id/timer_session_teal_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC006b5f"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_teal_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC82d5c7"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_blue_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC39608f"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_blue_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCa3c9fe"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_violet_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC69548d"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_violet_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCd4bbfc"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_amber_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC835414"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_amber_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCf9ba72"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_rose_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC8e4958"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_rose_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCffb2bf"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_indigo_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC525a92"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_indigo_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCbbc3ff"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_cyan_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC006876"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_cyan_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC82d3e2"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_green_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC3b6939"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_green_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCa1d39a"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_lime_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC626118"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_lime_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCcccb76"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_orange_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC8f4c38"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_orange_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCffb5a0"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_red_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC904a44"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_red_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCffb4ac"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_pink_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC8d4a5a"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_pink_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCffb1c2"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_brown_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC8f4c34"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_brown_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CCffb59c"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_slate_light"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC0e6681"
                android:shadowRadius="9"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer_session_slate_dark"
                style="@style/WidgetTimerSession"
                android:shadowColor="#CC8ad0ee"
                android:shadowRadius="9"
                android:visibility="gone" />
            <!-- end of glow variants -->
        </FrameLayout>
        <Chronometer
            android:id="@+id/timer_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tile1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/tile2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/tile3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/tile4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tile5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/tile6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/tile7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/tile8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
